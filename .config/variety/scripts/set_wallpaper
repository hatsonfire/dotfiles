#!/bin/bash
#
# This is a more robust script for setting wallpapers with hyprpaper.
# It first tells hyprpaper to preload the new image into memory,
# and then it sets that preloaded image as the current wallpaper.
# This prevents errors where hyprpaper is asked to display an image
# that it hasn't loaded yet.

# The first argument ($1) is the full path to the wallpaper from Variety.
IMAGE_PATH="$1"

# Step 1: Preload the new wallpaper.
hyprctl hyprpaper preload "$IMAGE_PATH"

# Step 2: Set the preloaded wallpaper.
# The ",$IMAGE_PATH" means apply to the current monitor the image path.
hyprctl hyprpaper wallpaper ",$IMAGE_PATH"
