{
    //-*- mode: jsonic -*-
    "layer": "top",
    "position": "top",
    "height": 40,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "pulseaudio#input",
        "tray"
    ],
    // Modules configuration
    "hyprland/workspaces": {
        "format": "{name}: {icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "default": ""
        }
    },
    "tray": {
        "icon-size": 18,
        "spacing": 10
    },
    "clock": {
        "interval": 1,
        "format": "{:%Y-%m-%d %I:%M:%S %p}",
        "tooltip-format": "<big>{:%Y %B}\n<tt>{calendar}</tt></big>"
    },
    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
        "on-click": "pavucontrol"
    },
    "pulseaudio#input": {
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "on-click": "pavucontrol"
    },
    "custom/variety": {
        "format": "{}",
        "tooltip": true,
        "tooltip-format": "<big>{}</big>",
        "exec-on-event": true,
        "exec": "basename \"$(variety --current)\" | sed -e 's/\\..*$//' -e 's/_/ /g' | cut -c1-30",
        "on-click": "variety -n", // Left-click: Next wallpaper
        "on-click-middle": "variety -f", // Middle-click: Favorite wallpaper
        "on-click-right": "variety -t", // Right-click: Trash wallpaper
        "on-scroll-up": "variety -n", // Scroll up: Next wallpaper
        "on-scroll-down": "variety -p" // Scroll down: Previous wallpaper
    }
}

